package com.joaovitor.controller;


public class QueriesController {
    private static Scanner scanner = new Scanner(System.in);
    private static PatientService pacienteService = new PacienteService();
    
    public static void main(String[] args) {
        System.out.println("Sistema de Gerenciamento de Consultas Médicas");
        
        while (true) {
            System.out.println("1. Adicionar Paciente\n2. Listar Pacientes\n3. Atualizar Paciente\n4. Remover Paciente\n5. Sair");
            int opcao = scanner.nextInt();
            scanner.nextLine();
            
            switch (opcao) {
                case 1:
                    System.out.println("Nome: ");
                    String nome = scanner.nextLine();
                    System.out.println("CPF: ");
                    String cpf = scanner.nextLine();
                    System.out.println("Telefone: ");
                    String telefone = scanner.nextLine();
                    System.out.println("Email: ");
                    String email = scanner.nextLine();
                    System.out.println("Plano de Saúde: ");
                    String planoSaude = scanner.nextLine();
                    pacienteService.adicionarPaciente(new Paciente(nome, cpf, telefone, email, planoSaude, new Date()));
                    break;
                case 2:
                    pacienteService.listarPacientes().forEach(System.out::println);
                    break;
                case 3:
                    System.out.println("Digite o CPF do paciente a ser atualizado: ");
                    String cpfUpdate = scanner.nextLine();
                    System.out.println("Novo Nome: ");
                    String novoNome = scanner.nextLine();
                    System.out.println("Novo Telefone: ");
                    String novoTelefone = scanner.nextLine();
                    System.out.println("Novo Email: ");
                    String novoEmail = scanner.nextLine();
                    System.out.println("Novo Plano de Saúde: ");
                    String novoPlano = scanner.nextLine();
                    if (pacienteService.atualizarPaciente(cpfUpdate, novoNome, novoTelefone, novoEmail, novoPlano)) {
                        System.out.println("Paciente atualizado com sucesso.");
                    } else {
                        System.out.println("Paciente não encontrado.");
                    }
                    break;
                case 4:
                    System.out.println("Digite o CPF do paciente a ser removido: ");
                    String cpfRemove = scanner.nextLine();
                    if (pacienteService.removerPaciente(cpfRemove)) {
                        System.out.println("Paciente removido com sucesso.");
                    } else {
                        System.out.println("Paciente não encontrado.");
                    }
                    break;
                case 5:
                    System.exit(0);
                    break;
                default:
                    System.out.println("Opção inválida.");
            }
        }
    }
}
